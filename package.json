{
  "name": "dark-fantacy-backend",
  "private": true,
  "version": "1.0.0",
  "description": "Dark fantacy backend",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:node18": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "dev:direct": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "db:import": "node scripts/import-mongo-dump.js",
    "db:check": "node scripts/check-db.cjs",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r ./dist/src/register-paths.js dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prebuild": "node -e \"console.log('Building backend with local toolchain')\"",
    "photos:migrate": "ts-node -r tsconfig-paths/register scripts/migrate-photos.ts",
    "premium:backfill": "ts-node -r tsconfig-paths/register scripts/backfill-premium.ts",
    "premium:test-user": "ts-node -r tsconfig-paths/register scripts/set-test-premium.ts",
    "s3:test": "node scripts/s3-smoke-test.js --sample",
    "otp:indexes": "ts-node -r tsconfig-paths/register scripts/phone-otp-indexes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-ses": "^3.1152.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@nestjs-modules/mailer": "^1.11.2",
    "@nestjs/bull": "^10.1.0",
    "@nestjs/common": "^10.3.3",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.3",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^10.0.4",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.3",
    "@nestjs/platform-socket.io": "^10.3.4",
    "@nestjs/schedule": "^4.0.2",
    "@nestjs/serve-static": "^4.0.1",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/websockets": "^10.3.4",
    "@types/bcrypt": "^5.0.2",
    "archiver": "^7.0.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.8",
    "input": "^1.0.1",
    "libphonenumber-js": "^1.13.15",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.2.1",
    "nodemailer": "^6.9.11",
    "nodemailer-handlebars": "^1.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "stripe": "^17.6.0",
    "twilio": "^5.13.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.3",
    "@types/cron": "^2.0.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.25",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
