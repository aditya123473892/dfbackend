<!DOCTYPE HTML
  PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml"
  xmlns:o="urn:schemas-microsoft-com:office:office">

<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <!--[if !mso]><!-->
  <meta http-equiv="X-UA-Compatible" content="IE=edge"><!--<![endif]-->
  <title>Daily Message Limit Reached</title>

  <style type="text/css">
    @media only screen and (min-width: 520px) {
      .u-row {
        width: 500px !important;
      }

      .u-row .u-col {
        vertical-align: top;
      }

      .u-row .u-col-100 {
        width: 500px !important;
      }
    }

    @media (max-width: 520px) {
      .u-row-container {
        max-width: 100% !important;
        padding-left: 0px !important;
        padding-right: 0px !important;
      }

      .u-row .u-col {
        min-width: 320px !important;
        max-width: 100% !important;
        display: block !important;
      }

      .u-row {
        width: 100% !important;
      }

      .u-col {
        width: 100% !important;
      }

      .u-col>div {
        margin: 0 auto;
      }
    }

    body {
      margin: 0;
      padding: 0;
      background-color: #f4f4f4;
      color: #333;
      font-family: Arial, sans-serif;
    }

    table,
    td {
      border-collapse: collapse;
    }

    p {
      margin: 0;
    }

    a[x-apple-data-detectors='true'] {
      color: inherit !important;
      text-decoration: none !important;
    }

    .email-container {
      width: 100%;
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      background-color: #ffffff;
      border-radius: 8px;
    }

    .email-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .email-body {
      font-size: 16px;
      line-height: 1.5;
      color: #555;
    }

    .email-footer {
      font-size: 14px;
      text-align: center;
      margin-top: 20px;
      color: #777;
    }

    .highlight {
      color: #3b99ff;
      font-weight: bold;
    }

    .subscribe-button {
      display: inline-block;
      padding: 10px 20px;
      background-color: #3b99ff;
      color: #ffffff;
      text-decoration: none;
      border-radius: 5px;
      margin-top: 10px;
    }
  </style>
</head>

<body>
  <div class="email-container">
    <div class="email-header">
      <h2>Daily Message Limit Reached</h2>
    </div>

    <div class="email-body">
      <p>Dear <span class="highlight">{{name}},</span></p>
      <p>You have reached your daily limit of <span class="highlight">5 free messages</span>. To continue messaging,
        please upgrade to a premium subscription.</p>

      {{#if coupons.length}}
      <p>We have some exciting offers for you! Use one of the following coupon codes to get a discount on your
        subscription:</p>
      <ul>
        {{#each coupons}}
        <li>
          <strong>Coupon Code:</strong> <span class="highlight">{{code}}</span><br />
          <strong>Plan Name:</strong> {{planName}}<br />
          <strong>Discount:</strong>
          {{#ifEquals discountType 'fixed'}}
          {{discountValue}}
          {{else}}
          {{discountValue}}% off
          {{/ifEquals}}
        </li>
        {{/each}}
      </ul>
      {{/if}}

      <p>Unlock unlimited messaging and other exclusive features by subscribing today.</p>
      <p><a href="{{url}}" class="subscribe-button">Upgrade Now</a></p>
      <p>Thank you for being a valued member of <span class="highlight">Dark Fantasy</span>!</p>
    </div>

    <div class="email-footer">
      <p>If you have any questions, feel free to contact our support team.</p>
      <p>Best regards,</p>
      <p>Dark Fantasy Team</p>
    </div>
  </div>
</body>

</html>