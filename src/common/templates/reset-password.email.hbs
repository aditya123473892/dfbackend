<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="x-apple-disable-message-reformatting">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>Reset Password</title>

  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: Arial, Helvetica, sans-serif;
    }

    .container {
      margin: 20px;
      background-color: #dfdede;
      padding: 20px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      text-align: center;
    }

    .container h1 {
      font-size: 20px;
      font-weight: bold;
      color: #000;
      margin-bottom: 20px;
    }

    .container p {
      font-size: 14px;
      color: #333;
      line-height: 1.6;
      margin: 10px 0;
      text-align: start;
    }

    .mail-content {
        max-width: 500px;
        margin: auto;
    }

    .button {
      display: inline-block;
      padding: 12px 24px;
      background-color: #e03a3a;
      color: #fff !important;
      text-decoration: none;
      border-radius: 4px;
      font-size: 14px;
      font-weight: bold;
      margin-top: 20px;
    }

    .button:hover {
      background-color: #c53030;
    }

    .footer {
      margin-top: 20px;
      font-size: 12px;
      color: #777;
      border-top: 1px solid gray;
    }

    @media (max-width: 520px) {
      .container {
        padding: 15px;
      }

      .container h1 {
        font-size: 18px;
      }

      .container p {
        font-size: 13px;
      }

      .button {
        padding: 10px 20px;
        font-size: 13px;
      }
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="mail-content">
        <h1>Reset your password</h1>
    <p>Hello {{name}},</p>
    <p>We received a request to reset the password for your account. If you did not make this request, please ignore this email.</p>
    <p>To reset your password, please click the link below:</p>
    <a href="{{url}}" class="button">Reset Password</a>
    <div class="footer">
      <p>Thank you,</p>
      <p>Dark Fantasy Team</p>
    </div>
    </div>
  </div>
</body>
</html>
