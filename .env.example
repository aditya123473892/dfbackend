PORT=9000
DATABASE_URL=mongodb://username:password@localhost:27017/?authSource=admin
DATABASE_NAME=darkfantasy
JWT_SECRET=replace_with_a_long_random_secret
PASSWORD_ENCRYPTION_PRIVATE_KEY=replace_with_64_random_hex_characters
EXPIRES_IN=7d
PUBLIC_SITE_DOMAIN=http://localhost:3000
ADMIN_SITE_DOMAIN=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000
AWS_DEFAULT_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET=
AWS_S3_REGION=
CHAT_MEDIA_MAX_FILE_SIZE=5242880
CHAT_MEDIA_MAX_ATTACHMENTS=5
CHAT_MEDIA_ALLOWED_TYPES=image/jpeg,image/webp
CHAT_MEDIA_URL_TTL_SECONDS=120
CHAT_MEDIA_DEFAULT_EXPIRY_HOURS=
CHAT_MEDIA_UPLOADS_PER_MINUTE=20

# Use IAM role credentials in deployments. Static credentials stay backend-only.
AWS_SESSION_TOKEN=
AWS_REKOGNITION_REGION=
PHOTO_MAX_PER_USER=20
# Videos (posts and vault): stored unchanged after a Rekognition video scan.
# The backend identity needs rekognition:StartContentModeration/GetContentModeration
# and s3:GetObject on temp/*; Rekognition must run in the bucket region.
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_PER_USER=20
VAULT_MAX_VIDEOS=20
# Local testing only: NODE_ENV=development and PHOTO_MODERATION_MODE=development-bypass.
# Deployment defaults require Rekognition and private-bucket verification.
PHOTO_MODERATION_MODE=rekognition
PHOTO_VERIFY_BUCKET_SETTINGS=true
# Exact HTTPS browser origins also configured on S3; empty for native-only Expo.
PHOTO_WEB_ORIGINS=

# Both buckets fall back to AWS_DEFAULT_S3_BUCKET when unset.
PHOTO_MEDIA_BUCKET=
PHOTO_PRIVATE_BUCKET=
# HTTPS CloudFront origin (no path), with OAC access ONLY to previews/* in PHOTO_MEDIA_BUCKET.
PHOTO_PREVIEW_BASE_URL=
# Authorized original GET lifetime, seconds; integer 300..3600 (default 15 minutes).
POST_IMAGE_URL_SECONDS=900
STORAGE_LAYOUT_READ=canonical
# disabled (default), report (read-only duplicate report), apply (report then background indexes)
PHOTO_STORAGE_INDEXES=disabled
# User-to-user block indexes: off (default), report (read-only duplicate report), apply.
# Block mutations and cross-process invalidation require a MongoDB replica set.
USER_BLOCK_INDEXES=off

# Phase 2: operator-managed indexes; evidence copy stays OFF until IAM is deployed.
REPORT_INDEXES=off
REPORT_EVIDENCE_COPY=off
REPORT_RETENTION_DAYS=90
# Rejected report attempts (missing / no access) allowed per user per hour.
REPORT_FAILED_HOURLY_LIMIT=20

# Phase 3: disabled by default, including production. See MODERATION.md.
MOD_API_ENABLED=off
STAFF_TOKEN_TTL_SECONDS=900
STAFF_MFA_ENABLED=off
STAFF_MFA_ISSUER=
# Separate insert-only StaffAuditLog principal; never put this in the Expo app.
STAFF_AUDIT_DATABASE_URL=

# Chat with God (AI guide). Off until DEEPSEEK_API_KEY is set; the key never leaves the backend.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GOD_CHAT_REQUESTS_PER_MINUTE=10

# Phone OTP sign-in (Twilio Verify). Backend-only secrets: never put these in the Expo app.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Country assumed for numbers typed without +country code (ISO 3166 alpha-2).
OTP_DEFAULT_COUNTRY=IN
OTP_RESEND_COOLDOWN_SECONDS=30
# Explicit development-only testing switch; ignored outside NODE_ENV=development.
# Set false and restart the backend to restore all app OTP limits.
OTP_DEV_BYPASS_RATE_LIMITS=false
OTP_SEND_PER_PHONE_10M=3
OTP_SEND_PER_PHONE_DAY=10
OTP_SEND_PER_IP_10M=10
OTP_SEND_PER_IP_DAY=50
OTP_VERIFY_PER_PHONE_10M=10
OTP_VERIFY_PER_IP_10M=30
OTP_BOOTSTRAP_PER_IP_10M=10
# Proxy hops in front of the API (e.g. 1 behind one load balancer); empty when exposed directly.
TRUST_PROXY=
# on: mobile-only routes (vault) require a phone OTP session. Turn on after pre-OTP app builds are retired.
MOBILE_OTP_ONLY_ROUTES=off
