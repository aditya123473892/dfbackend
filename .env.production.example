NODE_ENV=production
PORT=9000
HOST=0.0.0.0
API_DOMAIN=api.your-domain.com
ACME_EMAIL=ops@your-domain.com
# Managed MongoDB replica set, e.g. Atlas. Never use the Windows localhost URL in Docker.
DATABASE_URL=mongodb+srv://aditya:<db_password>@cluster0.by1ww6f.mongodb.net/darkfantasy?retryWrites=true&w=majority&appName=darkfantasy
DATABASE_NAME=darkfantasy
JWT_SECRET=
# Exactly 64 cryptographically random hexadecimal characters; keep stable across deploys.
PASSWORD_ENCRYPTION_PRIVATE_KEY=
EXPIRES_IN=7d
PUBLIC_API_URL=https://api.your-domain.com
# Web frontend handling existing password-reset links.
PUBLIC_SITE_DOMAIN=https://your-domain.com
ADMIN_SITE_DOMAIN=https://admin.your-domain.com
FRONTEND_ORIGIN=https://your-domain.com,https://admin.your-domain.com
TRUST_PROXY=1
SWAGGER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEFAULT_COUNTRY=IN
OTP_DEV_BYPASS_RATE_LIMITS=false
MOBILE_OTP_ONLY_ROUTES=off
AWS_DEFAULT_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_SES_REGION=ap-south-1
AWS_MAIL_FROM=
# Prefer an IAM role. If necessary supply both credentials through the host secret store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PHOTO_MODERATION_MODE=rekognition
PHOTO_VERIFY_BUCKET_SETTINGS=true
STORAGE_LAYOUT_READ=canonical
PHOTO_STORAGE_INDEXES=disabled
USER_BLOCK_INDEXES=off
REPORT_INDEXES=off
MOD_API_ENABLED=off
REPORT_EVIDENCE_COPY=off
# Optional Chat with God; secrets remain on backend only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
MOBILE_PHONE_AUTH_REQUIRED=true
