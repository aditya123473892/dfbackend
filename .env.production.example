# Production settings for api.darkfantasy.club. Copy to .env.production on the server,
# fill every blank value, and keep it out of Git. See DEPLOYMENT.md.
# The Docker image to run; deploy/deploy.sh pulls it.
BACKEND_IMAGE=ghcr.io/aditya123473892/dfbackend:3112026
NODE_ENV=production
PORT=9000
HOST=0.0.0.0
API_DOMAIN=api.darkfantasy.club
ACME_EMAIL=support@darkfantasy.com
# Managed MongoDB replica set, e.g. Atlas. Never use the Windows localhost URL in Docker.
DATABASE_URL=mongodb+srv://aditya:<db_password>@cluster0.by1ww6f.mongodb.net/darkfantasy?retryWrites=true&w=majority&appName=darkfantasy
DATABASE_NAME=darkfantasy
JWT_SECRET=
# Exactly 64 cryptographically random hexadecimal characters; keep stable across deploys.
PASSWORD_ENCRYPTION_PRIVATE_KEY=
EXPIRES_IN=7d
PUBLIC_API_URL=https://api.darkfantasy.club
# Web frontend handling existing password-reset links.
PUBLIC_SITE_DOMAIN=https://darkfantasy.club
ADMIN_SITE_DOMAIN=https://admin.darkfantasy.club
FRONTEND_ORIGIN=https://darkfantasy.club,https://admin.darkfantasy.club
TRUST_PROXY=1
SWAGGER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_DEFAULT_COUNTRY=IN
OTP_DEV_BYPASS_RATE_LIMITS=false
MOBILE_OTP_ONLY_ROUTES=off
AWS_DEFAULT_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_S3_REGION=ap-south-1
AWS_SES_REGION=ap-south-1
AWS_MAIL_FROM=no-reply@darkfantasy.club
# Prefer an IAM role. If necessary supply both credentials through the host secret store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
PHOTO_MODERATION_MODE=rekognition
PHOTO_VERIFY_BUCKET_SETTINGS=true
STORAGE_LAYOUT_READ=canonical
PHOTO_STORAGE_INDEXES=disabled
USER_BLOCK_INDEXES=off
REPORT_INDEXES=off
MOD_API_ENABLED=off
REPORT_EVIDENCE_COPY=off
# Optional Chat with God; secrets remain on backend only.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REQUEST_TIMEOUT_SECONDS=120
# false: email and password sign-up in the app (matches the store build).
MOBILE_PHONE_AUTH_REQUIRED=false
GOD_CHAT_FREE_DAILY_MESSAGES=10
# Optional: Expo access token if "enhanced push security" is on in Expo.
EXPO_ACCESS_TOKEN=
